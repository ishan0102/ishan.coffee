{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "ishan.cafe"
        }
      ],
      "destination": "http://devbox.pleco-galaxy.ts.net:8765/hub",
      "permanent": false
    },
    {
      "source": "/photos",
      "has": [
        {
          "type": "host",
          "value": "ishan.cafe"
        }
      ],
      "destination": "http://devbox.pleco-galaxy.ts.net:8765/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ishan.cafe"
        }
      ],
      "destination": "https://ishan.coffee/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.ishan.cafe"
        }
      ],
      "destination": "http://devbox.pleco-galaxy.ts.net:8765/hub",
      "permanent": false
    },
    {
      "source": "/photos",
      "has": [
        {
          "type": "host",
          "value": "www.ishan.cafe"
        }
      ],
      "destination": "http://devbox.pleco-galaxy.ts.net:8765/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.ishan.cafe"
        }
      ],
      "destination": "https://ishan.coffee/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ],
      "has": [
        {
          "type": "host",
          "value": "albums.ishan.cafe"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/a/:album([0-9a-f]{32})/",
      "destination": "https://devbox.pleco-galaxy.ts.net/a/:album/",
      "has": [
        {
          "type": "host",
          "value": "albums.ishan.cafe"
        }
      ]
    },
    {
      "source": "/a/:album([0-9a-f]{32})",
      "destination": "https://devbox.pleco-galaxy.ts.net/a/:album/",
      "has": [
        {
          "type": "host",
          "value": "albums.ishan.cafe"
        }
      ]
    },
    {
      "source": "/a/:album([0-9a-f]{32})/:photo([0-9a-f]{64}).jpg",
      "destination": "https://devbox.pleco-galaxy.ts.net/a/:album/:photo.jpg",
      "has": [
        {
          "type": "host",
          "value": "albums.ishan.cafe"
        }
      ]
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "albums.ishan.cafe"
        }
      ],
      "destination": "/__unknown_shared_album__"
    }
  ]
}
